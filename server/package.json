{
  "name": "ecocraft-api",
  "version": "1.0.0",
  "description": "EcoCraft REST API terpusat (Express + SQLite) untuk klien Web, Mobile, dan Desktop",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node src/db/seed.js",
    "test": "node --test tests/api.test.js"
  },
  "author": "Kelompok EcoCraft",
  "license": "UNLICENSED",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  },
  "engines": {
    "node": ">=18"
  },
  "nodemonConfig": {
    "ignore": [
      "database.sqlite",
      "database.sqlite-journal",
      "uploads/*",
      "tests/*"
    ]
  },
  "private": true
}